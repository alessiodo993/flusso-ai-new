# Copia in .env.local e riempi i valori. Nessuna di queste chiavi va committata.

# --- Supabase -------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Scavalca le RLS: solo lato server, mai in una variabile NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ------------------------------------------------------------
# console.anthropic.com → API keys. Usata solo dentro app/api/ai/*.
ANTHROPIC_API_KEY=

# --- Google Calendar ------------------------------------------------------
# Google Cloud → Credentials → OAuth client ID (tipo "Web application").
# Unico redirect URI da registrare: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chiave AES-256-GCM per cifrare i token in google_accounts.
# Generala con: openssl rand -base64 32
GOOGLE_TOKEN_SECRET=

# --- App ------------------------------------------------------------------
# URL pubblico: serve ai redirect OAuth e ai link nelle email.
APP_URL=http://localhost:3000
